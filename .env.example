# ============================================================================
# Copy to `.env` and edit.  Every value below has a safe offline default, so
# the system runs end-to-end with an EMPTY .env file.
#
# This project is an educational research prototype. It is not a medical
# device and its output is not a diagnosis.
# ============================================================================

# --- Server ---------------------------------------------------------------
MEDAI_HOST=127.0.0.1
MEDAI_PORT=8000
MEDAI_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Database -------------------------------------------------------------
# Relative to backend/. `make demo` recreates this file from scratch.
MEDAI_DATABASE_URL=sqlite:///./data/medai.db

# --- LLM provider abstraction ---------------------------------------------
# "null" = deterministic offline mode. All structured fields (risk_level,
# recommended_department, historical_changes, score_breakdown) are ALWAYS
# computed by the rule engine regardless of this setting. An LLM only ever
# rewrites prose (reasoning_summary / longitudinal_summary) and can never
# alter a structured field.
MEDAI_LLM_PROVIDER=null

# --- OpenAI (only read when MEDAI_LLM_PROVIDER=openai) ---------------------
MEDAI_OPENAI_API_KEY=
MEDAI_OPENAI_BASE_URL=https://api.openai.com/v1
MEDAI_OPENAI_MODEL=gpt-4o-mini

# --- DeepSeek (only read when MEDAI_LLM_PROVIDER=deepseek) -----------------
MEDAI_DEEPSEEK_API_KEY=
MEDAI_DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
MEDAI_DEEPSEEK_MODEL=deepseek-chat

# --- Imaging Agent ----------------------------------------------------------
# mock_preset      = predefined structured findings, ALWAYS badged as DEMO
# uploaded_report  = parse a radiology report pasted/uploaded by the user
# A real CXR CNN is deliberately out of scope (would require torch + weights).
MEDAI_IMAGING_MODE=mock_preset

# --- RAG --------------------------------------------------------------------
# bm25 = pure-Python lexical retrieval, zero dependencies, fully offline.
MEDAI_RAG_RETRIEVER=bm25
MEDAI_RAG_TOP_K=4

# --- Safety -----------------------------------------------------------------
# Refuses to serve results if any diagnostic wording leaks into output.
# Do not disable.
MEDAI_ENFORCE_SAFETY_GUARD=true
